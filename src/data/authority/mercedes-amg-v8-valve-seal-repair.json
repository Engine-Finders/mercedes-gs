    {
      "kind": "steps",
      "heading": "Our AMG V8 Repair Process",
      "steps": [
        {
          "title": "Vehicle Arrival & Inspection",
          "body": "We collect your vehicle (nationwide recovery available) and perform a full visual and diagnostic assessment to confirm the scope."
        },
        {
          "title": "Engine Bay Preparation",
          "body": "Remove airbox, ignition components, and valve covers. Lock the camshafts and remove the chain tensioner."
        },
        {
          "title": "Valve-Seal Replacement",
          "body": "Using specialised tools, compress valve springs, remove old seals, install new OE-spec seals, and reassemble."
        },
        {
          "title": "Coolant System Overhaul",
          "body": "Pressure test, replace all suspect seals, hoses, thermostat housings, and refill with correct coolant mix."
        },
        {
          "title": "Reassembly & Torqueing",
          "body": "Fit new torque-to-yield bolts and sealant as required, reassemble all components to factory torque specs."
        },
        {
          "title": "Testing & Road Trial",
          "body": "Run engine to temperature, perform a full cooling system bleed, and road-test to ensure leak-free operation."
        }
      ]
    },
